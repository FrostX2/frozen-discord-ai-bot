# Discord
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id_here

# AI Provider (OpenAI-compatible API)
# For OpenAI:
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your_openai_api_key
# AI_MODEL=gpt-4o

# For any OpenAI-compatible API (Anthropic via proxy, Ollama, LM Studio, etc.):
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your_api_key_here
AI_MODEL=gpt-4o

# Bot settings
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_SYSTEM_PROMPT=You are a helpful assistant in a Discord server. Be concise, friendly, and engaging.
