# Discord
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id_here

# Primary AI Provider (OpenAI-compatible API)
# For OpenAI:
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your_openai_api_key
#
# For Groq:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_your_groq_api_key
#
# For any OpenAI-compatible API (Ollama, LM Studio, etc.):
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your_api_key_here
AI_MODEL=gpt-4o

# Custom system prompt (overrides default)
AI_SYSTEM_PROMPT=You are a helpful assistant in a Discord server. Be concise, friendly, and engaging.

# Bot settings
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024

# Additional AI providers (JSON array)
# Add extra AI providers alongside the primary one. The system will route
# model names to the correct provider automatically.
#
# Format: JSON array of objects with: id, baseURL, apiKey, models[]
#
# AI_PROVIDERS=[{"id":"groq","baseURL":"https://api.groq.com/openai/v1","apiKey":"gsk-...","models":["llama-3.3-70b-versatile","mixtral-8x7b-32768"]}]
#
# AI_PROVIDERS=[{"id":"openai","baseURL":"https://api.openai.com/v1","apiKey":"sk-...","models":["gpt-4o","gpt-4o-mini"]},{"id":"groq","baseURL":"https://api.groq.com/openai/v1","apiKey":"gsk-...","models":["llama-3.3-70b-versatile"]}]
AI_PROVIDERS=
